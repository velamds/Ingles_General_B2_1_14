ective", "content": "secondary_7"}]}, {"responses": [{"correct": 1, "_data": [{"type": "text", "content": "true"}], "id": 0, "selected": 0}, {"correct": 0, "_data": [{"type": "text", "content": "false"}], "id": 1, "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "text", "content": "Rose doesn't want to consider new job opportunities. "}]}, {"type": "objective", "content": "secondary_7"}]}], "template_override": 1, "id": 8, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "How does Rose feel about her current job? "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Click on TRUE if the statement is true.</span> <span class=\"bullet\">Click on FALSE if the statement is false. </span>"}, {"type": "audio", "content": "engenn9le14ob08re6aud01"}]}]}, {"stimuli_ids": [], "type": "GIW", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": "asking"}], "id": 1, "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": "I'll be"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "asked"}]}, {"type": "post_question", "contents": {"type": "", "content": "the company for a pay raise."}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": "given"}], "id": 1, "selected": 0}], "id": 1, "_data": [{"type": "question", "contents": [{"type": "text", "content": "I will have"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "gived"}]}, {"type": "post_question", "contents": {"type": "", "content": "my company a chance by not applying for other jobs."}}, {"type": "objective", "content": "secondary_8"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": "be"}], "id": 1, "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "text", "content": "I'll "}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "being"}]}, {"type": "post_question", "contents": {"type": "", "content": "looking for other job options if they don't listen to me."}}, {"type": "objective", "content": "secondary_8"}]}], "template_override": 1, "id": 9, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Rob talks about his future at his job."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions:\n<span class=\"bullet\">Proofread the sentence.</span>\n<span class=\"bullet\">Click on the incorrect word.</span>\n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span>"}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le14ob08re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Watch the movie <span class=\"italic\">Back to the Future</span>."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Reading"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "<span class=\"strong\">Instructions: </span>Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le14ob08re2img01.jpg", "audiosrc": "engenn9le14ob08re2aud01", "images": [{"time": "0", "image": "engenn9le14ob08re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le14ob08re2img01.jpg", "text": "<span class=\"strong\">James</span>: It's been a long week! I'm exhausted.\n<br/><span class=\"strong\">Kirk</span>: Me too. I don't know if I can keep up this pace indefinitely, especially since I am on such a low salary. I feel like they always take advantage of me.\n<br/><span class=\"strong\">James</span>: Have you considered changing jobs? There are a number of advertising agencies downtown.\n<br/><span class=\"strong\">Kirk</span>: Yeah, I think I'm going to consider my options. Soon, I'll be hitting my breaking point. The boss had promised a pay raise and new job title but it hasn't eventuated.", "id": 1}, {"time": "34000", "image": "engenn9le14ob08re2img02.jpg", "text": "<span class=\"strong\">James</span>: I can understand your frustration. At your age, you should be starting to not only pay your bills but also be thinking about putting some money away in a savings account each month.\n<br/><span class=\"strong\">Kirk</span>: Maybe I'll ask my boss for a meeting to discuss my future. I'm going to tell him my goals for the future and see whether he will consider making some changes.\n<br/><span class=\"strong\">James</span>: Good idea. Everyone has dreams about what they will be doing in the future. If she is not prepared to have a frank discussion about your future with the agency, then be prepared to move on.", "id": 2}, {"time": "66000", "image": "engenn9le14ob08re2img03.jpg", "text": "<span class=\"strong\">Kirk</span>: Exactly. By meeting with my boss before I make any decisions, I will have given her a chance to consider my future at <span class=\"italic\">Advantage Ads</span>. Then, I will be looking for possible job opportunities.\n<br/><span class=\"strong\">James</span>: You never know what might happen. She may have some grand plans for you in the agency.\n<br/><span class=\"strong\">Kirk</span>: Maybe ... I am still hoping that I will have achieved my professional goals before I turn thirty.\n<br/><span class=\"strong\">James</span>: You are going to have to tell me what happens.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "text": "", "id": 0}, {"time": "5000", "image": "", "text": "Writing About Work", "id": 1}, {"time": "41000", "image": "", "text": "<span class=\"bullet\">Workplace situations.</span>", "id": 2}, {"time": "78000", "image": "", "text": "<span class=\"bullet\">Use going to for intentions.</span>", "id": 3}, {"time": "92000", "image": "", "text": "<span class=\"bullet\">Use will for predictions and simple facts about the future.</span>", "id": 4}, {"time": "107000", "image": "", "text": "<span class=\"bullet\">Use the Present Continuous tense for arrangements.</span>", "id": 5}, {"time": "119000", "image": "", "text": "<span class=\"bullet\">Use the Present Simple tense for future scheduled events.</span>", "id": 6}], "video_src": "engenn9le14ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Talking About the Future"}, {"type": "unit_name", "content": "By The Time I'm 30"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 14}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe hypothetical situations in written and spoken interactions according to work and social contexts."}, {"type": "secondary_1", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_2", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_3", "content": " Writes well organized texts about the application for a job in an international organization through the correct use of formality expressions, grammar, and coherence and cohesion aspects appropriate for this level. "}, {"type": "secondary_4", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_5", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_6", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_7", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}, {"type": "secondary_8", "content": "Writes effective texts in English showing good organization and appropriate use of language to create the intended effect for the purpose and context. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Future Tenses"}, {"type": "describer", "content": "You can talk about the future in several different ways. "}, {"type": "text", "content": "You use the auxiliary verb <span class=\"strong\">going to</span> to talk about intentions. (An intention is a plan for the future that you have already thought about.)"}, {"type": "text", "content": "You use the auxiliary verb <span class=\"strong\">will</span> to make predictions or simple statements of fact about the future."}, {"type": "text", "content": "You use the Present Continuous tense to talk about arrangements. (An arrangement is is a plan for the future that you have already thought about <span class=\"strong\">and discussed with someone else</span>.)"}, {"type": "text", "content": "You use the Present Simple tense to refer to future events that are scheduled."}, {"type": "example", "content": "I'm going to tell him my goals for the future and see whether he will consider making some changes."}, {"type": "example", "content": "Maybe I'll ask my boss for a meeting to discuss my future."}, {"type": "example", "content": "Then, I will be looking for possible job opportunities."}, {"type": "example", "content": "When does the meeting begin?"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Future Continuous and Future Perfect"}, {"type": "describer", "content": "You use the Future Continuous tense when you refer to an  unfinished action or event that will be happening at a time later than now.<br/>You use the Future Perfect tense when you refer to a completed action in the future. When you use the tense, you are projecting yourself forward and looking back at the action."}, {"type": "text", "content": "The Future Continuous tense has two different forms:"}, {"type": "text", "content": "<div class=\"center_text\"> \"<span class=\"italic\">will be doing</span>\" and \"<span class=\"italic\">be going to be doing</span>\" </div>"}, {"type": "text", "content": "Examples: <br/><span class=\"italic\">Your boss <span class=\"strong\">will be waiting</span> for you in her office. <br/>Your boss <span class=\"strong\">is going to be waiting</span> for you in her office.</span>"}, {"type": "text", "content": "The Future Perfect tense also has two different forms: "}, {"type": "text", "content": "\"<span class=\"italic\">will have done</span>\" and \"<span class=\"italic\">be going to have done</span>\" "}, {"type": "text", "content": "Examples:  <br/><span class=\"italic\">You <span class=\"strong\">will have agreed</span> on a new contract by the time you leave her office. <br/>You <span class=\"strong\">are going to have to</span> agree on a new contract by the time you leave her office.</span>"}, {"type": "example", "content": "I am still hoping that I will have achieved my professional goals before I turn thirty."}, {"type": "example", "content": "By meeting with my boss before I make any decisions, I will have given her a chance to consider my future at Advantage Ads. "}, {"type": "example", "content": "Soon, I will be hitting my breaking point."}, {"type": "example", "content": "Everyone has dreams about what they will be doing in the future. "}, {"type": "example", "content": "You are going to have to tell me what happens."}]}, {"type": "background_image", "content": "engenn9le14ob08re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "breaking point"}, {"type": "definition", "content": "the time when problems become so great that a person can no longer deal with them"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: I will be hitting my breaking point soon."}, {"type": "audio", "content": "engenn9le14ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear in a workplace about someone's future in their job."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "pace"}, {"type": "definition", "content": "the \u200bspeed at which something \u200bhappens"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: I don't know if I can keep up this pace indefinitely."}, {"type": "audio", "content": "engenn9le14ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "grand"}, {"type": "definition", "content": "impressive because of size, importance, etc."}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: She may have some grand plans for you in the agency."}, {"type": "audio", "content": "engenn9le14ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "advertising agency"}, {"type": "definition", "content": "an agency employed by companies to create and manage their advertising campaigns"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: There are a number of advertising agencies downtown."}, {"type": "audio", "content": "engenn9le14ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to eventuate"}, {"type": "definition", "content": "to happen as a result of something"}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: The boss had promised a pay raise and new job title but it hasn't eventuated."}, {"type": "audio", "content": "engenn9le14ob08aud05"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find the movie <span class=\"italic\">Back to the Future</span>."}, {"type": "text", "content": "Watch the movie in English with subtitles."}, {"type": "text", "content": "Take notes about some of the main events."}, {"type": "text", "content": "Tell a friend about the movie."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I watch a movie about the future."}, {"type": "text", "content": "I take notes on the main events in the movie."}, {"type": "text", "content": "I tell a friend about the movie."}]}]}